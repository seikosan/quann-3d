{"status":"ok","message-type":"work-list","message-version":"1.0.0","message":{"facets":{},"total-results":1038341,"items":[{"institution":[{"name":"Northeastern University"}],"indexed":{"date-parts":[[2023,11,18]],"date-time":"2023-11-18T00:41:08Z","timestamp":1700268068490},"reference-count":0,"publisher":"Northeastern University Library","content-domain":{"domain":[],"crossmark-restriction":false},"DOI":"10.17760\/d20581926","type":"dissertation","created":{"date-parts":[[2023,11,17]],"date-time":"2023-11-17T14:31:56Z","timestamp":1700231516000},"approved":{"date-parts":[[2023]]},"source":"Crossref","is-referenced-by-count":0,"title":["Permutation invariant graph learning"],"prefix":"10.17760","author":[{"given":"Kimia","family":"Shayestehfard","sequence":"first","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]}],"member":"7402","deposited":{"date-parts":[[2023,11,17]],"date-time":"2023-11-17T14:51:12Z","timestamp":1700232672000},"score":26.504387,"resource":{"primary":{"URL":"http:\/\/hdl.handle.net\/2047\/D20581926"}},"issued":{"date-parts":[[null]]},"references-count":0,"URL":"https:\/\/doi.org\/10.17760\/d20581926"},{"indexed":{"date-parts":[[2026,10,4]],"date-time":"2026-10-04T13:25:33Z","timestamp":1791120333961,"version":"4.1.0"},"reference-count":0,"publisher":"Centre pour la Communication Scientifique Directe (CCSD)","issue":"Proceedings","content-domain":{"domain":[],"crossmark-restriction":false},"abstract":"<jats:p xml:lang=\"en\">We present a characteristic-free algorithm for computing minimal generating sets of invariant rings of permutation groups. We circumvent the main weaknesses of the usual approaches (using classical Gr\u00f6bner basis inside the full polynomial ring, or pure linear algebra inside the invariant ring) by relying on the theory of SAGBI- Gr\u00f6bner basis. This theory takes, in this special case, a strongly combinatorial flavor, which makes it particularly effective. Our algorithm does not require the computation of a Hironaka decomposition, nor even the computation of a system of parameters, and could be parallelized. Our implementation, as part of the library $permuvar$ for $mupad$, is in many cases much more efficient than the other existing software.<\/jats:p>","DOI":"10.46298\/dmtcs.2285","type":"journal-article","created":{"date-parts":[[2021,8,23]],"date-time":"2021-08-23T22:01:45Z","timestamp":1629756105000},"source":"Crossref","is-referenced-by-count":7,"title":["Computing Minimal Generating Sets of Invariant Rings of Permutation Groups with SAGBI-Gr\u00f6bner Basis"],"prefix":"10.46298","volume":"DMTCS Proceedings vol. AA,...","author":[{"ORCID":"https:\/\/orcid.org\/0000-0002-2735-8921","authenticated-orcid":false,"given":"Nicolas","family":"Thi\u00e9ry","sequence":"first","affiliation":[{"name":"Universit\u00e9 Claude Bernard Lyon 1"}],"role":[{"vocabulary":"crossref","role":"author"}]}],"member":"25203","published-online":{"date-parts":[[2001,1,1]]},"container-title":["Discrete Mathematics &amp; Theoretical Computer Science"],"language":"en","link":[{"URL":"https:\/\/dmtcs.episciences.org\/2285\/pdf","content-type":"application\/pdf","content-version":"vor","intended-application":"text-mining"},{"URL":"https:\/\/dmtcs.episciences.org\/2285\/pdf","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}],"deposited":{"date-parts":[[2023,6,20]],"date-time":"2023-06-20T20:12:56Z","timestamp":1687291976000},"score":26.317585,"resource":{"primary":{"URL":"https:\/\/dmtcs.episciences.org\/2285"}},"issued":{"date-parts":[[2001,1,1]]},"references-count":0,"journal-issue":{"issue":"Proceedings","published-online":{"date-parts":[[2001,1,1]]}},"URL":"https:\/\/doi.org\/10.46298\/dmtcs.2285","relation":{"is-same-as":[{"id-type":"uri","id":"https:\/\/hal.science\/hal-01182965v1","asserted-by":"subject"}]},"ISSN":["1365-8050"],"issn-type":[{"value":"1365-8050","type":"electronic"}],"published":{"date-parts":[[2001,1,1]]},"article-n