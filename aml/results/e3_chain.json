  "experiment": "AML E3 chain-aware features and dual-channel cloud design",
  "data": "synthetic_aml_typologies",
  "generator": {
    "transactions": 20000,
    "windows": 2000,
    "window_size": 10,
    "classes": [
      "normal",
      "structuring",
      "layering",
      "velocity"
    ],
    "seed": 20261016
  },
  "split": {
    "train": 1200,
    "val": 400,
    "test": 400,
    "method": "same account-window stratified split as E0/E1",
    "train_seed": 20261016,
    "validation_test_seed": 20261017
  },
  "feature_sets": {
    "base": {
      "features": [
        "amount_median",
        "amount_p95",
        "threshold_share",
        "time_of_day_hour",
        "inter_tx_interval_min",
        "counterparty_count",
        "channel",
        "window_count",
        "rate_per_hour",
        "chain_hops",
        "window_duration_min"
      ],
      "raw_counterparty_id": false
    },
    "base+chain": {
      "features": [
        "amount_median",
        "amount_p95",
        "threshold_share",
        "time_of_day_hour",
        "inter_tx_interval_min",
        "counterparty_count",
